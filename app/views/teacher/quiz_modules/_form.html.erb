<%= form_with model: @module, url: @module.persisted? ? teacher_quiz_module_path(@module, locale: I18n.locale) : teacher_quiz_modules_path(locale: I18n.locale), class: "mt-8 space-y-6 rounded-xl border ink-rule bg-bg2 p-6 sm:p-8" do |f| %>
  <% if @module.errors.any? %><div class="border-l-4 border-red bg-red/10 p-4 text-sm text-red"><%= @module.errors.full_messages.to_sentence %></div><% end %>
  <aside class="rounded-lg border-l-4 border-accent bg-bg1 p-4 text-sm leading-6 text-tx1"><strong class="text-tx0"><%= t("teacher.quiz_setup_title") %>.</strong> <%= t("teacher.quiz_setup_steps") %></aside>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= f.label :title_pt, t("teacher.title_pt"), class: "mb-2 block text-sm font-bold" %><%= f.text_field :title_pt, required: true, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div><div><%= f.label :title_en, t("teacher.title_en"), class: "mb-2 block text-sm font-bold" %><%= f.text_field :title_en, required: true, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= f.label :slug, t("teacher.slug"), class: "mb-2 block text-sm font-bold" %><%= f.text_field :slug, required: true, pattern: "[a-z0-9-]+", class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div><div><%= f.label :position, t("teacher.position"), class: "mb-2 block text-sm font-bold" %><%= f.number_field :position, required: true, min: 1, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div></div>
  <div class="rounded-lg bg-bg1 p-4"><div class="flex flex-wrap gap-6 text-sm"><label class="flex items-center gap-2"><%= f.check_box :unlocked %><%= t("teacher.unlocked") %></label><label class="flex items-center gap-2"><%= f.check_box :published %><%= t("teacher.published") %></label><div><%= f.label :audience, t("teacher.audience"), class: "mr-2 font-bold" %><%= f.select :audience, [[t("teacher.audience_public"), "public_audience"], [t("teacher.audience_classroom"), "classroom_audience"]], {}, class: "focus-ink rounded-md border border-bg3 px-3 py-2" %></div></div><p class="mt-3 text-sm leading-6 text-tx1"><%= t("teacher.visibility_hint") %></p></div>
  <div class="flex flex-wrap justify-between gap-4"><%= link_to t("teacher.back"), teacher_quiz_modules_path(locale: I18n.locale), class: "focus-ink editorial-link py-3 text-sm font-bold" %><%= f.submit t("teacher.save"), class: "focus-ink cursor-pointer rounded-md bg-accent px-5 py-3 text-xs font-extrabold tracking-[0.1em] text-bg2 uppercase hover:bg-tx0" %></div>
<% end %>
