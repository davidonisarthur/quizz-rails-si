<section class="mx-auto max-w-4xl py-10 sm:py-16">
  <div class="flex flex-wrap items-end justify-between gap-5">
    <div>
      <p class="eyebrow"><%= t("teacher.preview") %></p>
      <h1 class="type-display mt-3 text-4xl sm:text-5xl"><%= @module.title_pt %></h1>
    </div>
    <%= link_to t("teacher.back"), teacher_quiz_module_path(@module, locale: I18n.locale), class: "focus-ink editorial-link py-3 text-sm font-bold" %>
  </div>

  <p class="mt-6 rounded-xl border-l-4 border-accent bg-bg2 p-4 text-sm text-tx1"><%= t("teacher.preview_notice") %></p>

  <div class="mt-8 space-y-6">
    <% @questions.each do |question| %>
      <article class="rounded-xl border ink-rule bg-bg2 p-6 sm:p-8">
        <p class="eyebrow"><%= t("teacher.question_number", number: question.position) %> · <%= question.published? ? t("teacher.published") : t("teacher.draft") %></p>
        <h2 class="mt-3 text-xl font-bold sm:text-2xl"><%= question.body_pt %></h2>
        <% if question.context_pt.present? %><p class="mt-4 text-tx1"><%= question.context_pt %></p><% end %>
        <ol class="mt-6 space-y-3">
          <% question.options.order(:id).each_with_index do |option, index| %>
            <li class="rounded-md border border-bg3 px-4 py-3 text-sm"><span class="mr-2 font-bold text-accent"><%= ("A".ord + index).chr %>)</span><%= option.text_pt %></li>
          <% end %>
        </ol>
      </article>
    <% end %>
  </div>
</section>
