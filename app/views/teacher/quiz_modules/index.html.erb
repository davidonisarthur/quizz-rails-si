<section class="mx-auto max-w-5xl py-10 sm:py-16">
  <div class="flex flex-wrap items-end justify-between gap-5">
    <div>
      <p class="eyebrow mb-3"><%= t("teacher.area") %></p>
      <h1 class="type-display text-4xl sm:text-5xl"><%= t("teacher.modules") %></h1>
    </div>
    <%= link_to t("teacher.new_module"), new_teacher_quiz_module_path(locale: I18n.locale), class: "focus-ink rounded-md bg-accent px-4 py-3 text-xs font-extrabold tracking-[0.1em] text-bg2 uppercase transition-colors hover:bg-tx0" %>
  </div>

  <div class="mt-8 space-y-3">
    <% @modules.each do |modulo| %>
      <article class="flex flex-wrap items-center justify-between gap-4 rounded-xl border ink-rule bg-bg2 p-5">
        <div><h2 class="font-bold"><%= modulo.title_pt %></h2><p class="mt-1 text-xs text-tx2"><%= modulo.slug %> · <%= modulo.published? ? t("teacher.published") : t("teacher.draft") %></p></div>
        <%= link_to t("teacher.manage"), teacher_quiz_module_path(modulo, locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" %>
      </article>
    <% end %>
  </div>
</section>
