<section class="mx-auto max-w-3xl py-10 sm:py-16"><%= link_to t("teacher.back"), teacher_study_modules_path(locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" %><article class="mt-8 rounded-xl border ink-rule bg-bg2 p-6 sm:p-8"><p class="eyebrow"><%= @study_module.published? ? t("teacher.published") : t("teacher.draft") %></p><h1 class="type-display mt-3 text-4xl"><%= @study_module.title_pt %></h1><p class="mt-4 text-lg text-tx1"><%= @study_module.summary_pt %></p><p class="mt-8 whitespace-pre-line leading-8 text-tx1"><%= @study_module.content_pt %></p><div class="mt-8 flex flex-wrap gap-4 text-sm font-bold"><%= link_to t("teacher.edit"), edit_teacher_study_module_path(@study_module, locale: I18n.locale), class: "focus-ink editorial-link" %><%= button_to t("teacher.delete"), teacher_study_module_path(@study_module, locale: I18n.locale), method: :delete, class: "focus-ink editorial-link cursor-pointer", form: { data: { turbo_confirm: t("teacher.confirm_delete") } } %></div></article></section>
