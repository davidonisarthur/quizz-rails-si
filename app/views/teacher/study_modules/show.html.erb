<section class="mx-auto max-w-4xl py-10 sm:py-16">
  <%= link_to t("teacher.back"), teacher_study_modules_path(locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" %>

  <article class="mt-8 rounded-xl border ink-rule bg-bg2 p-6 sm:p-8">
    <p class="eyebrow"><%= @study_module.published? ? t("teacher.published") : t("teacher.draft") %> · <%= @study_module.audience_public_audience? ? t("teacher.audience_public") : t("teacher.audience_classroom") %></p>
    <h1 class="type-display mt-3 text-4xl"><%= @study_module.title_pt %></h1>
    <p class="mt-4 text-lg text-tx1"><%= @study_module.summary_pt %></p>
    <div class="mt-8 border-t ink-rule pt-8 leading-8 text-tx1">
      <% if @study_module.rich_content_pt.body&.to_plain_text.to_s.squish.present? %>
        <div class="trix-content"><%= @study_module.rich_content_pt %></div>
      <% else %>
        <%= simple_format(@study_module.content_pt) %>
      <% end %>
    </div>

    <% if @study_module.quiz_module %>
      <section class="mt-8 rounded-lg bg-bg1 p-4" aria-labelledby="related-quiz-title">
        <p class="eyebrow"><%= t("study.management.related_quiz") %></p>
        <h2 id="related-quiz-title" class="mt-2 font-bold"><%= @study_module.quiz_module.title_pt %></h2>
        <%= link_to t("teacher.manage_quiz"), teacher_quiz_module_path(@study_module.quiz_module, locale: I18n.locale), class: "focus-ink editorial-link mt-3 inline-block text-sm font-bold" %>
      </section>
    <% end %>

    <div class="mt-8 flex flex-wrap gap-4 text-sm font-bold">
      <%= link_to t("teacher.edit"), edit_teacher_study_module_path(@study_module, locale: I18n.locale), class: "focus-ink editorial-link" %>
      <%= button_to t("teacher.delete"), teacher_study_module_path(@study_module, locale: I18n.locale), method: :delete, class: "focus-ink editorial-link cursor-pointer", form: { data: { turbo_confirm: t("teacher.confirm_delete") } } %>
    </div>
  </article>

  <section class="mt-6 rounded-xl border ink-rule bg-bg2 p-6 sm:p-8">
    <p class="eyebrow"><%= t("teacher.audience") %></p>
    <% if @study_module.audience_public_audience? %>
      <h2 class="type-display mt-2 text-2xl"><%= t("teacher.audience_public") %></h2>
      <p class="mt-3 text-sm leading-6 text-tx1"><%= t("teacher.public_study_access_hint") %></p>
    <% else %>
      <h2 class="type-display text-2xl"><%= t("classrooms.assignments") %></h2>
      <p class="mt-3 text-sm leading-6 text-tx1"><%= t("teacher.classroom_study_access_hint") %></p>
      <% if @classrooms.any? %>
        <%= form_with url: teacher_study_module_study_module_assignments_path(@study_module, locale: I18n.locale), class: "mt-4 flex flex-wrap gap-3" do |f| %>
          <%= f.label :classroom_id, t("classrooms.assign_to"), class: "sr-only" %>
          <%= f.select :classroom_id, @classrooms.map { |classroom| [classroom.name, classroom.id] }, {}, class: "focus-ink rounded-md border border-bg3 px-3 py-2" %>
          <%= f.submit t("classrooms.assign"), class: "focus-ink cursor-pointer rounded-md bg-accent px-4 py-2 text-xs font-extrabold text-bg2 uppercase" %>
        <% end %>
      <% else %>
        <div class="mt-5 rounded-lg border border-dashed border-bg3 bg-bg1 p-4 text-sm leading-6 text-tx1">
          <p><%= t("teacher.create_classroom_before_assigning") %></p>
          <%= link_to t("teacher.create_classroom"), teacher_classrooms_path(locale: I18n.locale), class: "focus-ink editorial-link mt-3 inline-block font-bold" %>
        </div>
      <% end %>

      <% if @assignments.any? %>
        <div class="mt-5 space-y-2">
          <% @assignments.each do |assignment| %>
            <div class="flex items-center justify-between gap-4 rounded-md bg-bg1 px-4 py-3 text-sm">
              <span class="font-bold"><%= assignment.classroom.name %></span>
              <%= button_to t("teacher.remove_classroom_access"), teacher_study_module_study_module_assignment_path(@study_module, assignment, locale: I18n.locale), method: :delete, class: "focus-ink min-h-11 text-sm font-bold text-red", form: { data: { turbo_confirm: t("teacher.confirm_remove_access") } } %>
            </div>
          <% end %>
        </div>
      <% elsif @classrooms.any? %>
        <p class="mt-5 rounded-lg border border-dashed border-bg3 bg-bg1 p-4 text-sm leading-6 text-tx1"><%= t("classrooms.no_study_assignments") %></p>
      <% end %>
    <% end %>
  </section>
</section>
