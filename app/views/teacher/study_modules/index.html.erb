<section class="mx-auto max-w-5xl py-10 sm:py-16">
  <div class="flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow mb-3"><%= t("teacher.area") %></p><h1 class="type-display text-4xl sm:text-5xl"><%= t("study.management.title") %></h1></div><%= link_to t("study.management.new"), new_teacher_study_module_path(locale: I18n.locale), class: "focus-ink rounded-md bg-accent px-4 py-3 text-xs font-extrabold tracking-[0.1em] text-bg2 uppercase hover:bg-tx0" %></div>
  <% if @study_modules.any? %><div class="mt-8 grid gap-4 md:grid-cols-2"><% @study_modules.each do |study_module| %><article class="rounded-xl border ink-rule bg-bg2 p-6"><p class="eyebrow"><%= study_module.published? ? t("teacher.published") : t("teacher.draft") %> · <%= study_module.audience_public_audience? ? t("teacher.audience_public") : t("teacher.audience_classroom") %></p><h2 class="type-display mt-3 text-2xl"><%= study_module.title_pt %></h2><p class="mt-3 text-sm leading-6 text-tx1"><%= study_module.summary_pt %></p><div class="mt-6 flex gap-4 text-sm font-bold"><%= link_to t("teacher.manage_study"), teacher_study_module_path(study_module, locale: I18n.locale), class: "focus-ink editorial-link" %><%= link_to t("teacher.edit"), edit_teacher_study_module_path(study_module, locale: I18n.locale), class: "focus-ink editorial-link" %></div></article><% end %></div><% else %><div class="mt-8 rounded-xl border border-dashed border-bg3 bg-bg2 p-8 text-center text-tx1"><%= t("study.management.empty") %></div><% end %>
</section>
