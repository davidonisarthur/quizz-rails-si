<section class="mx-auto max-w-5xl py-10 sm:py-16">
  <%= link_to t("teacher.back"), teacher_root_path(locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" %>

  <header class="mt-8 flex flex-wrap items-end justify-between gap-5">
    <div class="max-w-2xl">
      <p class="eyebrow"><%= t("teacher.area") %></p>
      <h1 class="type-display mt-3 text-4xl sm:text-5xl"><%= t("study.management.title") %></h1>
      <p class="mt-4 text-sm leading-7 text-tx1 sm:text-base"><%= t("study.management.index_description") %></p>
    </div>
    <%= link_to t("study.management.new"), new_teacher_study_module_path(locale: I18n.locale), class: "focus-ink inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-4 py-3 text-xs font-extrabold tracking-[0.1em] text-bg2 uppercase hover:bg-tx0" %>
  </header>

  <% if @study_modules.any? %>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <% @study_modules.each do |study_module| %>
        <article class="flex flex-col rounded-xl border ink-rule bg-bg2 p-6">
          <p class="eyebrow"><%= study_module.published? ? t("teacher.published") : t("teacher.draft") %> · <%= study_module.audience_public_audience? ? t("teacher.audience_public") : t("teacher.audience_classroom") %></p>
          <h2 class="type-display mt-3 text-2xl"><%= study_module.title_pt %></h2>
          <p class="mt-3 text-sm leading-6 text-tx1"><%= study_module.summary_pt %></p>
          <p class="mt-4 text-xs text-tx2"><%= study_module.slug %></p>
          <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-6 text-sm font-bold">
            <%= link_to t("teacher.manage_study"), teacher_study_module_path(study_module, locale: I18n.locale), class: "focus-ink editorial-link inline-flex min-h-11 items-center" %>
            <%= link_to t("teacher.edit"), edit_teacher_study_module_path(study_module, locale: I18n.locale), class: "focus-ink editorial-link inline-flex min-h-11 items-center" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <section class="mt-8 rounded-xl border border-dashed border-bg3 bg-bg2 p-6 sm:p-8" aria-labelledby="empty-study-title">
      <p class="eyebrow text-accent"><%= t("study.management.title") %></p>
      <h2 id="empty-study-title" class="type-display mt-2 text-2xl"><%= t("study.management.empty") %></h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-tx1"><%= t("study.management.empty_description") %></p>
      <%= link_to t("study.management.new"), new_teacher_study_module_path(locale: I18n.locale), class: "focus-ink mt-5 inline-flex min-h-11 items-center rounded-md bg-accent px-4 text-xs font-extrabold tracking-[0.08em] text-bg2 uppercase hover:bg-tx0" %>
    </section>
  <% end %>
</section>
