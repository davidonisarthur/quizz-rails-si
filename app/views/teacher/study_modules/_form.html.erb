<%= form_with model: @study_module, url: @study_module.persisted? ? teacher_study_module_path(@study_module, locale: I18n.locale) : teacher_study_modules_path(locale: I18n.locale), class: "mt-8 space-y-6 rounded-xl border ink-rule bg-bg2 p-6 sm:p-8" do |f| %>
  <% if @study_module.errors.any? %><div class="border-l-4 border-red bg-red/10 p-4 text-sm text-red"><%= @study_module.errors.full_messages.to_sentence %></div><% end %>

  <div class="grid gap-5 sm:grid-cols-2"><div><%= f.label :title_pt, t("study.management.title_pt"), class: "mb-2 block text-sm font-bold" %><%= f.text_field :title_pt, required: true, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div><div><%= f.label :title_en, t("study.management.title_en"), class: "mb-2 block text-sm font-bold" %><%= f.text_field :title_en, required: true, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= f.label :summary_pt, t("study.management.summary_pt"), class: "mb-2 block text-sm font-bold" %><%= f.text_area :summary_pt, required: true, rows: 3, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div><div><%= f.label :summary_en, t("study.management.summary_en"), class: "mb-2 block text-sm font-bold" %><%= f.text_area :summary_en, required: true, rows: 3, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= f.label :content_pt, t("study.management.content_pt"), class: "mb-2 block text-sm font-bold" %><%= f.text_area :content_pt, required: true, rows: 8, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div><div><%= f.label :content_en, t("study.management.content_en"), class: "mb-2 block text-sm font-bold" %><%= f.text_area :content_en, required: true, rows: 8, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= f.label :libras_content_pt, t("study.management.libras_content_pt"), class: "mb-2 block text-sm font-bold" %><%= f.text_area :libras_content_pt, required: true, rows: 5, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div><div><%= f.label :libras_content_en, t("study.management.libras_content_en"), class: "mb-2 block text-sm font-bold" %><%= f.text_area :libras_content_en, required: true, rows: 5, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div></div>
  <div class="grid gap-5 sm:grid-cols-3"><div><%= f.label :slug, t("teacher.slug"), class: "mb-2 block text-sm font-bold" %><%= f.text_field :slug, required: true, pattern: "[a-z0-9-]+", class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div><div><%= f.label :position, t("teacher.position"), class: "mb-2 block text-sm font-bold" %><%= f.number_field :position, required: true, min: 1, class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div><div><%= f.label :video_url, t("study.management.video_url"), class: "mb-2 block text-sm font-bold" %><%= f.url_field :video_url, placeholder: "https://", class: "focus-ink w-full rounded-md border border-bg3 px-3 py-2" %></div></div>
  <div><%= f.label :quiz_module_id, t("study.management.related_quiz"), class: "mb-2 block text-sm font-bold" %><%= f.collection_select :quiz_module_id, current_user.authored_quiz_modules.order(:position), :id, :title_pt, { include_blank: t("study.management.no_related_quiz") }, class: "focus-ink min-h-11 w-full rounded-md border border-bg3 px-3 py-2" %></div>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box :published %><%= t("teacher.published") %></label>
  <div class="flex flex-wrap justify-between gap-4"><%= link_to t("teacher.back"), teacher_study_modules_path(locale: I18n.locale), class: "focus-ink editorial-link py-3 text-sm font-bold" %><%= f.submit t("teacher.save"), class: "focus-ink cursor-pointer rounded-md bg-accent px-5 py-3 text-xs font-extrabold tracking-[0.1em] text-bg2 uppercase hover:bg-tx0" %></div>
<% end %>
