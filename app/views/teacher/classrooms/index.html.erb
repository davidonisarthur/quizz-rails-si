<section class="mx-auto max-w-4xl py-10 sm:py-16">
  <header class="max-w-3xl">
    <%= link_to t("teacher.back"), teacher_root_path(locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" %>
    <p class="eyebrow mt-8"><%= t("teacher.area") %></p>
    <h1 class="type-display mt-3 text-4xl sm:text-5xl"><%= t("classrooms.manage_title") %></h1>
    <p class="mt-4 text-sm leading-7 text-tx1 sm:text-base"><%= t("classrooms.description") %></p>
  </header>

  <section class="mt-8 rounded-xl border ink-rule bg-bg2 p-5 sm:p-6" aria-labelledby="new-classroom-title">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow text-accent"><%= t("classrooms.step", number: 1) %></p>
        <h2 id="new-classroom-title" class="type-display mt-2 text-2xl"><%= t("classrooms.create") %></h2>
      </div>
      <p class="max-w-sm text-sm leading-6 text-tx1"><%= t("classrooms.create_hint") %></p>
    </div>
    <%= form_with model: @classroom, url: teacher_classrooms_path(locale: I18n.locale), class: "mt-4 flex flex-col gap-3 sm:flex-row" do |f| %>
      <%= f.label :name, t("classrooms.name"), class: "sr-only" %>
      <%= f.text_field :name, placeholder: t("classrooms.name"), class: "focus-ink min-h-11 w-full flex-1 rounded-md border border-bg3 px-3 py-2" %>
      <%= f.submit t("classrooms.create"), class: "focus-ink min-h-11 w-full cursor-pointer rounded-md bg-accent px-4 py-2 text-xs font-extrabold text-bg2 uppercase sm:w-auto" %>
    <% end %>
  </section>

  <% if @classrooms.any? %>
  <div class="mt-8 space-y-3" aria-label="<%= t("classrooms.title") %>">
    <% @classrooms.each do |classroom| %>
      <article class="flex flex-wrap items-center justify-between gap-4 rounded-xl border ink-rule bg-bg2 p-5">
        <div class="min-w-0">
          <h2 class="type-display text-2xl"><%= classroom.name %></h2>
          <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-tx2">
            <div><dt class="sr-only"><%= t("classrooms.students") %></dt><dd><%= t("classrooms.students_count", count: classroom.students.size) %></dd></div>
            <div><dt class="sr-only"><%= t("teacher.quizzes") %></dt><dd><%= t("classrooms.quizzes_count", count: classroom.quiz_modules.size) %></dd></div>
            <div><dt class="sr-only"><%= t("study.management.title") %></dt><dd><%= t("classrooms.study_contents_count", count: classroom.study_modules.size) %></dd></div>
          </dl>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <%= link_to t("classrooms.manage"), teacher_classroom_path(classroom, locale: I18n.locale), class: "focus-ink editorial-link min-h-11 py-3 text-sm font-bold" %>
          <%= button_to t("classrooms.delete"), teacher_classroom_path(classroom, locale: I18n.locale), method: :delete, class: "focus-ink min-h-11 text-sm font-bold text-red", form: { data: { turbo_confirm: t("classrooms.confirm_delete") } } %>
        </div>
      </article>
    <% end %>
  </div>
  <% else %>
    <section class="mt-8 rounded-xl border border-dashed border-bg3 bg-bg2 p-6 sm:p-8" aria-labelledby="classrooms-empty-title">
      <p class="eyebrow text-accent"><%= t("classrooms.step", number: 1) %></p>
      <h2 id="classrooms-empty-title" class="type-display mt-2 text-2xl"><%= t("classrooms.empty_title") %></h2>
      <p class="mt-3 max-w-xl text-sm leading-7 text-tx1"><%= t("classrooms.empty_description") %></p>
    </section>
  <% end %>
</section>
