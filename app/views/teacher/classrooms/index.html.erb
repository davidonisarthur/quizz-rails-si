<section class="mx-auto max-w-4xl py-10 sm:py-16"><h1 class="type-display text-4xl"><%= t("classrooms.title") %></h1><%= form_with model: @classroom, url: teacher_classrooms_path(locale: I18n.locale), class: "mt-6 flex gap-3" do |f| %><%= f.text_field :name, placeholder: t("classrooms.name"), class: "focus-ink flex-1 rounded-md border border-bg3 px-3 py-2" %><%= f.submit t("classrooms.create"), class: "focus-ink cursor-pointer rounded-md bg-accent px-4 py-2 text-xs font-extrabold text-bg2 uppercase" %><% end %><div class="mt-8 space-y-3"><% @classrooms.each do |classroom| %><article class="flex items-center justify-between border-b ink-rule py-4"><div><h2 class="font-bold"><%= classroom.name %></h2><p class="text-sm text-tx2"><%= classroom.students.count %> <%= t("classrooms.students") %></p></div><%= link_to t("teacher.manage"), teacher_classroom_path(classroom, locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" %></article><% end %></div></section>
