<section class="mx-auto max-w-4xl py-10 sm:py-16"><%= link_to t("teacher.back"), teacher_classrooms_path(locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" %><h1 class="type-display mt-5 text-4xl"><%= @classroom.name %></h1><%= form_with url: teacher_classroom_classroom_enrollments_path(@classroom, locale: I18n.locale), class: "mt-8 flex gap-3" do |f| %><%= f.email_field :email, placeholder: t("classrooms.student_email"), class: "focus-ink flex-1 rounded-md border border-bg3 px-3 py-2" %><%= f.submit t("classrooms.add_student"), class: "focus-ink cursor-pointer rounded-md bg-accent px-4 py-2 text-xs font-extrabold text-bg2 uppercase" %><% end %><div class="mt-8 space-y-3"><% @classroom.classroom_enrollments.includes(:user).each do |enrollment| %><article class="flex items-center justify-between border-b ink-rule py-4"><span><%= enrollment.user.name %> · <%= enrollment.user.email %></span><%= button_to t("teacher.delete"), teacher_classroom_classroom_enrollment_path(@classroom, enrollment, locale: I18n.locale), method: :delete, class: "focus-ink text-red" %></article><% end %></div></section>
