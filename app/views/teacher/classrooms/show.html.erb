<section class="mx-auto max-w-4xl py-10 sm:py-16"><%= link_to t("teacher.back"), teacher_classrooms_path(locale: I18n.locale), class: "focus-ink editorial-link min-h-11 py-3 text-sm font-bold" %><h1 class="type-display mt-5 text-4xl"><%= @classroom.name %></h1><%= form_with url: teacher_classroom_classroom_enrollments_path(@classroom, locale: I18n.locale), class: "mt-8 flex flex-col gap-3 sm:flex-row" do |f| %><%= f.email_field :email, placeholder: t("classrooms.student_email"), class: "focus-ink min-h-11 w-full flex-1 rounded-md border border-bg3 px-3 py-2" %><%= f.submit t("classrooms.add_student"), class: "focus-ink min-h-11 w-full cursor-pointer rounded-md bg-accent px-4 py-2 text-xs font-extrabold text-bg2 uppercase sm:w-auto" %><% end %><div class="mt-8 space-y-3"><% @classroom.classroom_enrollments.includes(:user).each do |enrollment| %><article class="flex flex-wrap items-center justify-between gap-3 border-b ink-rule py-4"><span class="min-w-0 break-all"><%= enrollment.user.name %> · <%= enrollment.user.email %></span><%= button_to t("teacher.delete"), teacher_classroom_classroom_enrollment_path(@classroom, enrollment, locale: I18n.locale), method: :delete, class: "focus-ink min-h-11 cursor-pointer px-2 text-red" %></article><% end %></div></section>
