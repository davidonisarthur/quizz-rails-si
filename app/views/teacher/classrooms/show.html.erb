<section class="mx-auto max-w-4xl py-10 sm:py-16">
  <%= link_to t("teacher.back"), teacher_classrooms_path(locale: I18n.locale), class: "focus-ink editorial-link min-h-11 py-3 text-sm font-bold" %>

  <header class="mt-5 flex flex-wrap items-end justify-between gap-5 border-b ink-rule pb-6">
    <div>
      <p class="eyebrow"><%= t("classrooms.title") %></p>
      <h1 class="type-display mt-3 text-4xl"><%= @classroom.name %></h1>
      <p class="mt-3 text-sm text-tx1"><%= t("classrooms.members_and_content", students: @classroom.students.size, quizzes: @classroom.quiz_modules.size, studies: @classroom.study_modules.size) %></p>
    </div>
    <%= button_to t("classrooms.delete"), teacher_classroom_path(@classroom, locale: I18n.locale), method: :delete, class: "focus-ink min-h-11 rounded-md border border-red/50 px-4 text-xs font-extrabold tracking-[0.08em] text-red uppercase transition-colors hover:bg-red hover:text-bg2", form: { data: { turbo_confirm: t("classrooms.confirm_delete") } } %>
  </header>

  <section class="mt-8 rounded-xl border ink-rule bg-bg2 p-5 sm:p-6" aria-labelledby="add-student-title">
    <p class="eyebrow text-accent"><%= t("classrooms.step", number: 2) %></p>
    <h2 id="add-student-title" class="type-display mt-2 text-2xl"><%= t("classrooms.add_student") %></h2>
    <p class="mt-2 text-sm leading-6 text-tx1"><%= t("classrooms.add_student_hint") %></p>
    <%= form_with url: teacher_classroom_classroom_enrollments_path(@classroom, locale: I18n.locale), class: "mt-4 flex flex-col gap-3 sm:flex-row" do |f| %>
      <%= f.label :email, t("classrooms.student_email"), class: "sr-only" %>
      <%= f.email_field :email, placeholder: t("classrooms.student_email"), class: "focus-ink min-h-11 w-full flex-1 rounded-md border border-bg3 px-3 py-2" %>
      <%= f.submit t("classrooms.add_student"), class: "focus-ink min-h-11 w-full cursor-pointer rounded-md bg-accent px-4 py-2 text-xs font-extrabold text-bg2 uppercase sm:w-auto" %>
    <% end %>
  </section>

  <section class="mt-8" aria-labelledby="enrolled-students-title">
    <h2 id="enrolled-students-title" class="type-display text-2xl"><%= t("classrooms.students") %></h2>
    <% if @classroom.classroom_enrollments.any? %>
    <div class="mt-4 space-y-3">
      <% @classroom.classroom_enrollments.includes(:user).each do |enrollment| %>
        <article class="flex flex-wrap items-center justify-between gap-3 rounded-xl border ink-rule bg-bg2 p-4">
          <span class="min-w-0 break-all"><%= enrollment.user.name %> · <%= enrollment.user.email %></span>
          <%= button_to t("teacher.delete"), teacher_classroom_classroom_enrollment_path(@classroom, enrollment, locale: I18n.locale), method: :delete, class: "focus-ink min-h-11 cursor-pointer px-2 text-red" %>
        </article>
      <% end %>
    </div>
    <% else %>
      <p class="mt-4 rounded-xl border border-dashed border-bg3 bg-bg2 p-5 text-sm leading-6 text-tx1"><%= t("classrooms.no_students") %></p>
    <% end %>
  </section>

  <section class="mt-10 border-t ink-rule pt-8" aria-labelledby="classroom-content-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow text-accent"><%= t("classrooms.step", number: 3) %></p>
        <h2 id="classroom-content-title" class="type-display mt-2 text-2xl"><%= t("classrooms.content_access") %></h2>
        <p class="mt-2 text-sm leading-6 text-tx1"><%= t("classrooms.assign_content_hint") %></p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to t("classrooms.create_quiz"), new_teacher_quiz_module_path(locale: I18n.locale), class: "focus-ink inline-flex min-h-11 items-center rounded-md border border-bg3 px-4 text-xs font-extrabold tracking-[0.08em] uppercase hover:border-accent hover:text-accent" %>
        <%= link_to t("classrooms.create_study"), new_teacher_study_module_path(locale: I18n.locale), class: "focus-ink inline-flex min-h-11 items-center rounded-md border border-bg3 px-4 text-xs font-extrabold tracking-[0.08em] uppercase hover:border-accent hover:text-accent" %>
      </div>
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      <article class="rounded-xl border ink-rule bg-bg2 p-5">
        <h3 class="type-display text-xl"><%= t("classrooms.assigned_quizzes") %></h3>
        <% if @classroom.quiz_modules.any? %>
          <ul class="mt-4 space-y-3 text-sm">
            <% @classroom.quiz_modules.order(:position).each do |quiz_module| %>
              <li><%= link_to quiz_module.title_pt, teacher_quiz_module_path(quiz_module, locale: I18n.locale), class: "focus-ink editorial-link font-bold" %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-4 text-sm leading-6 text-tx1"><%= t("classrooms.no_quiz_assignments") %></p>
        <% end %>
      </article>

      <article class="rounded-xl border ink-rule bg-bg2 p-5">
        <h3 class="type-display text-xl"><%= t("classrooms.assigned_studies") %></h3>
        <% if @classroom.study_modules.any? %>
          <ul class="mt-4 space-y-3 text-sm">
            <% @classroom.study_modules.order(:position).each do |study_module| %>
              <li><%= link_to study_module.title_pt, teacher_study_module_path(study_module, locale: I18n.locale), class: "focus-ink editorial-link font-bold" %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-4 text-sm leading-6 text-tx1"><%= t("classrooms.no_study_assignments") %></p>
        <% end %>
      </article>
    </div>
  </section>
</section>
