<section class="mx-auto max-w-5xl py-10 sm:py-16">
  <div class="flex flex-wrap items-end justify-between gap-5">
    <div>
      <p class="eyebrow mb-3"><%= t("teacher.area") %></p>
      <h1 class="type-display text-4xl sm:text-5xl"><%= t("teacher.dashboard") %></h1>
    </div>
    <div class="flex flex-wrap gap-3"><%= link_to t("classrooms.title"), teacher_classrooms_path(locale: I18n.locale), class: "focus-ink rounded-md border border-bg3 px-4 py-3 text-xs font-extrabold tracking-[0.1em] uppercase" %><%= link_to t("study.management.title"), teacher_study_modules_path(locale: I18n.locale), class: "focus-ink rounded-md border border-bg3 px-4 py-3 text-xs font-extrabold tracking-[0.1em] uppercase" %><%= link_to t("teacher.new_module"), new_teacher_quiz_module_path(locale: I18n.locale), class: "focus-ink rounded-md bg-accent px-4 py-3 text-xs font-extrabold tracking-[0.1em] text-bg2 uppercase transition-colors hover:bg-tx0" %></div>
  </div>

  <% if @modules.any? %>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <% @modules.each do |modulo| %>
        <article class="rounded-xl border ink-rule bg-bg2 p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="eyebrow"><%= modulo.published? ? t("teacher.published") : t("teacher.draft") %></p>
              <h2 class="type-display mt-2 text-2xl"><%= modulo.title_pt %></h2>
            </div>
            <span class="text-sm text-tx2"><%= modulo.questions.count %> <%= t("teacher.questions") %></span>
          </div>
          <div class="mt-6 flex gap-4 text-sm font-bold">
            <%= link_to t("teacher.manage"), teacher_quiz_module_path(modulo, locale: I18n.locale), class: "focus-ink editorial-link" %>
            <%= link_to t("teacher.reports"), report_teacher_quiz_module_path(modulo, locale: I18n.locale), class: "focus-ink editorial-link" %>
            <%= link_to t("teacher.edit"), edit_teacher_quiz_module_path(modulo, locale: I18n.locale), class: "focus-ink editorial-link" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="mt-8 rounded-xl border border-dashed border-bg3 bg-bg2 p-8 text-center">
      <p class="text-tx1"><%= t("teacher.no_modules") %></p>
    </div>
  <% end %>

  <section class="mt-14 border-t ink-rule pt-8">
    <div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow"><%= t("study.management.title") %></p><h2 class="type-display mt-2 text-3xl"><%= t("study.management.dashboard_title") %></h2></div><%= link_to t("study.management.new"), new_teacher_study_module_path(locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" %></div>
    <% if @study_modules.any? %><div class="mt-6 grid gap-4 md:grid-cols-2"><% @study_modules.each do |study_module| %><article class="rounded-xl border ink-rule bg-bg2 p-5"><p class="eyebrow"><%= study_module.published? ? t("teacher.published") : t("teacher.draft") %></p><h3 class="type-display mt-2 text-xl"><%= study_module.title_pt %></h3><%= link_to t("teacher.manage"), teacher_study_module_path(study_module, locale: I18n.locale), class: "focus-ink editorial-link mt-5 inline-block text-sm font-bold" %></article><% end %></div><% else %><p class="mt-5 text-sm text-tx1"><%= t("study.management.empty") %></p><% end %>
  </section>
</section>
