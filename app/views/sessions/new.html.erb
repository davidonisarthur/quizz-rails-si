<div class="max-w-md mx-auto py-10 px-4">
  <h2 class="text-3xl font-bold mb-6 text-center"><%= t('sessions.title') %></h2>

  <%= form_with url: session_path(locale: I18n.locale), class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email, t('sessions.email'), class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, required: true, class: "w-full p-2.5 rounded-lg border border-bg3 bg-bg2 text-tx0 focus:ring-2 focus:ring-accent focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, t('sessions.password'), class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, required: true, class: "w-full p-2.5 rounded-lg border border-bg3 bg-bg2 text-tx0 focus:ring-2 focus:ring-accent focus:outline-none" %>
    </div>

    <%= f.submit t('sessions.submit'), class: "w-full bg-accent text-white py-2.5 rounded-lg font-bold hover:brightness-110 shadow transition cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-center text-sm text-tx1">
    <%= t('sessions.no_account') %> <%= link_to t('sessions.sign_up'), new_user_path(locale: I18n.locale), class: "text-accent hover:underline font-semibold" %>
  </p>
</div>
