<section class="mx-auto max-w-3xl py-10 sm:py-16">
  <p class="eyebrow mb-4"><%= t('brand.subtitle') %></p>
  <h1 class="type-display text-5xl sm:text-6xl"><%= t('ranking.title') %></h1>
  <div class="mt-8 overflow-hidden rounded-xl border ink-rule bg-bg2">
    <table class="w-full text-left">
      <thead class="border-b ink-rule">
        <tr class="text-[0.65rem] font-extrabold tracking-[0.12em] text-tx1 uppercase">
          <th class="py-4 pr-3"><%= t('ranking.position') %></th><th class="py-4 pr-3"><%= t('ranking.name') %></th><th class="py-4 text-right"><%= t('ranking.score') %></th>
        </tr>
      </thead>
      <tbody>
        <% @ranking.each_with_index do |user, index| %>
          <tr class="border-b ink-rule last:border-b-0 hover:bg-bg1">
            <td class="module-index py-5 pr-3">#<%= index + 1 %></td><td class="py-5 pr-3 text-lg font-bold"><%= user.name %></td><td class="type-display py-5 text-right text-3xl text-accent"><%= user.total_score %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
