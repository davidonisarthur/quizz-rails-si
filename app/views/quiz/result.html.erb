<section class="quiz-result py-10 sm:py-16">
  <p class="eyebrow"><%= I18n.locale == :en ? @module.title_en : @module.title_pt %></p>
  <div class="quiz-result-card">
    <div>
      <h1 class="type-display max-w-2xl text-4xl leading-tight sm:text-5xl"><%= t('quiz.completed_title') %></h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-tx1"><%= t('quiz.score_label') %></p>
    </div>
    <div class="quiz-result-card__score" role="img" aria-label="<%= t('quiz.score_label') %>: <%= @score %> / <%= @total %>">
      <strong><%= @score %> <span>/ <%= @total %></span></strong>
    </div>
  </div>
  <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-4">
    <%= link_to t('quiz.back_home'), root_path(locale: I18n.locale), class: "focus-ink quiz-secondary-action" %>
    <%= link_to play_quiz_module_path(@module.slug, locale: I18n.locale), class: "focus-ink quiz-primary-action" do %>
      <%= t('quiz.try_again') %><span aria-hidden="true">→</span>
    <% end %>
  </div>
</section>
