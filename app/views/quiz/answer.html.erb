<div class="mx-auto max-w-3xl py-4 sm:py-10">
  <%= turbo_frame_tag "quiz_content" do %>
    <% progress = (((@current_index + 1).to_f / @total_questions) * 100).round %>
    <header class="mb-10 border-y-2 ink-rule py-4">
      <div class="mb-3 flex items-center justify-between gap-4 text-xs font-extrabold tracking-[0.12em] text-tx1 uppercase">
        <span><%= t('quiz.progress', current: @current_index + 1, total: @total_questions) %></span>
        <span class="text-accent"><%= progress %>%</span>
      </div>
      <div class="h-[3px] bg-bg3" aria-hidden="true"><div class="h-full bg-accent transition-all duration-500" style="width: <%= progress %>%"></div></div>
    </header>

    <section class="border-y-2 py-8 ink-rule <%= @feedback.kind == 'correct' ? 'border-green text-green' : 'border-red text-red' %>">
      <p class="eyebrow mb-3 text-current"><%= @feedback.kind == 'correct' ? t('quiz.correct') : t('quiz.incorrect') %></p>
      <h1 class="type-display text-4xl leading-tight sm:text-5xl"><%= @feedback.kind == 'correct' ? t('quiz.correct') : t('quiz.incorrect') %></h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-tx0"><%= I18n.locale == :en ? @feedback.body_en : @feedback.body_pt %></p>
    </section>

    <div class="mt-8">
      <% if @next_question %>
        <%= link_to play_quiz_module_path(@module.slug, locale: I18n.locale, question_index: @next_index), class: "focus-ink inline-flex items-center gap-3 border-2 border-tx0 px-5 py-3 text-xs font-extrabold tracking-[0.12em] uppercase transition-colors hover:bg-tx0 hover:text-bg2" do %>
          <%= t('quiz.next_question') %><span aria-hidden="true">→</span>
        <% end %>
      <% else %>
        <%= link_to result_quiz_module_path(@module.slug, locale: I18n.locale), data: { turbo_frame: "_top" }, class: "focus-ink inline-flex items-center gap-3 border-2 border-tx0 px-5 py-3 text-xs font-extrabold tracking-[0.12em] uppercase transition-colors hover:bg-tx0 hover:text-bg2" do %>
          <%= t('quiz.see_result') %><span aria-hidden="true">→</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
