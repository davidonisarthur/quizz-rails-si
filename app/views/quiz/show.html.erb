<div class="mx-auto max-w-3xl py-8 sm:py-14">
  <%= turbo_frame_tag "quiz_content" do %>
    <% progress = ((@current_index.to_f / @total_questions) * 100).round %>
    <header class="mb-8 rounded-xl border ink-rule bg-bg2 p-5 sm:p-6">
      <div class="mb-3 flex items-center justify-between gap-4 text-xs font-extrabold tracking-[0.12em] text-tx1 uppercase">
        <span><%= t('quiz.progress', current: @current_index + 1, total: @total_questions) %></span>
        <span class="text-accent"><%= progress %>%</span>
      </div>
      <div class="h-[3px] bg-bg3" aria-hidden="true"><div class="h-full bg-accent transition-all duration-500 ease-out" style="width: <%= progress %>%"></div></div>
    </header>

    <section class="mb-8 rounded-xl border ink-rule bg-bg2 p-6 sm:p-9">
      <p class="eyebrow mb-4"><%= I18n.locale == :en ? @module.title_en : @module.title_pt %></p>
      <h1 class="type-display max-w-3xl text-3xl leading-tight sm:text-4xl"><%= I18n.locale == :en ? @question.body_en : @question.body_pt %></h1>

      <% if @question.context_pt.present? %>
        <p class="mt-7 max-w-2xl border-l-2 border-accent pl-5 text-base leading-7 text-tx1"><%= I18n.locale == :en ? @question.context_en : @question.context_pt %></p>
      <% end %>

      <% if libras_mode_enabled? %>
        <div class="mt-7 flex flex-wrap gap-3">
          <button type="button" data-controller="vlibras" data-action="click->vlibras#translate" data-vlibras-text-value="<%= [(I18n.locale == :en ? @question.body_en : @question.body_pt), (@question.context_pt.present? ? (I18n.locale == :en ? @question.context_en : @question.context_pt) : nil)].compact.join(' ') %>" class="focus-ink inline-flex items-center gap-2 border border-amber px-4 py-3 text-xs font-extrabold tracking-[0.1em] text-amber uppercase transition-colors hover:bg-amber hover:text-bg2 cursor-pointer" aria-label="<%= t('quiz.translate_with_vlibras') %>">
            <span aria-hidden="true">↗</span><%= t('quiz.translate_with_vlibras') %>
          </button>

          <% if @question.libras_embed_url.present? %>
            <div data-controller="libras-modal">
              <button type="button" data-action="click->libras-modal#open" data-video-url="<%= @question.libras_embed_url %>" class="focus-ink inline-flex items-center gap-2 border border-tx0 px-4 py-3 text-xs font-extrabold tracking-[0.1em] uppercase transition-colors hover:bg-tx0 hover:text-bg2 cursor-pointer" aria-label="<%= t('quiz.watch_in_libras') %>">
                <span aria-hidden="true">▶</span><%= t('quiz.watch_video_libras') %>
              </button>

              <div data-libras-modal-target="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-tx0/75 p-4" role="dialog" aria-modal="true" aria-labelledby="libras-video-title" tabindex="-1" data-action="click->libras-modal#closeOnBackdrop keydown@window->libras-modal#handleKeydown">
                <div class="w-full max-w-3xl border-2 border-tx0 bg-bg2">
                  <div class="flex items-center justify-between border-b-2 ink-rule px-5 py-4">
                    <h2 id="libras-video-title" class="type-display text-2xl"><%= t('quiz.libras_mode') %></h2>
                    <button type="button" data-action="click->libras-modal#close" data-libras-modal-target="closeButton" class="focus-ink editorial-link cursor-pointer text-xs font-extrabold tracking-[0.1em] uppercase"><%= t('quiz.close') %></button>
                  </div>
                  <div class="aspect-video w-full bg-tx0">
                    <iframe data-libras-modal-target="iframe" src="" class="h-full w-full" loading="lazy" sandbox="allow-scripts allow-same-origin allow-presentation" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen title="<%= t('quiz.libras_mode') %>"></iframe>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <div class="space-y-3">
      <% @options.each_with_index do |option, index| %>
        <%= button_to answer_quiz_module_path(@module.slug, locale: I18n.locale, option_index: index, question_id: @question.id), method: :post, class: "focus-ink group flex w-full gap-5 rounded-xl border ink-rule bg-bg2 px-5 py-5 text-left text-base font-semibold transition-colors hover:border-accent hover:bg-bg1 cursor-pointer sm:px-6 sm:text-lg" do %>
          <span class="module-index text-accent"><%= (index + 65).chr %></span>
          <span class="pt-0.5"><%= I18n.locale == :en ? option.text_en : option.text_pt %></span>
          <span aria-hidden="true" class="ml-auto pt-0.5 text-accent opacity-0 transition-opacity group-hover:opacity-100">→</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
