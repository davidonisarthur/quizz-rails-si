<section class="mx-auto max-w-4xl py-10"><h1 class="type-display text-4xl"><%= t("teacher_requests.title") %></h1><div class="mt-8 space-y-3"><% @requests.each do |request| %><article class="flex items-center justify-between border-b ink-rule py-4"><span><strong><%= request.user.name %></strong> · <%= request.user.email %></span><div class="flex gap-3"><%= button_to t("teacher_requests.approve"), approve_admin_teacher_access_request_path(request, locale: I18n.locale), method: :patch, class: "focus-ink cursor-pointer text-green" %><%= button_to t("teacher_requests.reject"), reject_admin_teacher_access_request_path(request, locale: I18n.locale), method: :patch, class: "focus-ink cursor-pointer text-red" %></div></article><% end %></div></section>
