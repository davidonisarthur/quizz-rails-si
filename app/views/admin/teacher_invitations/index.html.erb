<section class="mx-auto max-w-4xl py-10"><h1 class="type-display text-4xl"><%= t("teacher_invitations.title") %></h1><%= form_with url: admin_teacher_invitations_path(locale: I18n.locale), class: "mt-8 flex gap-3" do |f| %><%= f.email_field :email, required: true, placeholder: t("sessions.email"), class: "focus-ink flex-1 rounded-md border border-bg3 px-3 py-2" %><%= f.submit t("teacher_invitations.create"), class: "focus-ink cursor-pointer rounded-md bg-accent px-4 py-2 text-xs font-extrabold text-bg2 uppercase" %><% end %><% if flash[:invitation_url] %><p class="mt-5 break-all border-l-4 border-accent bg-bg1 p-4 text-sm"><%= flash[:invitation_url] %></p><% end %></section>
