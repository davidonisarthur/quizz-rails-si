<% dashboard = local_assigns.fetch(:dashboard, false) %>
<section class="module-catalog <%= "module-catalog--dashboard" if dashboard %>" aria-labelledby="module-catalog-title">
  <div class="module-catalog__heading">
    <div>
      <p class="eyebrow mb-2"><%= t('brand.subtitle') %></p>
      <h2 id="module-catalog-title" class="type-display text-3xl sm:text-4xl"><%= heading %></h2>
    </div>
    <% if dashboard %>
      <%= link_to t("home.view_all_modules"), quiz_modules_path(locale: I18n.locale), class: "focus-ink dashboard-text-link" %>
    <% else %>
      <span class="text-sm font-semibold text-tx2"><%= @modules.count %> <%= t('modules.title') %></span>
    <% end %>
  </div>

  <div class="module-catalog__list">
    <% @modules.each do |modulo| %>
      <% available = modulo.available_to?(current_user) %>
      <% completed = defined?(@attempted_module_ids) && @attempted_module_ids.include?(modulo.id) %>
      <article class="module-card <%= "module-card--locked" unless available %>">
        <span class="module-card__index" aria-hidden="true"><%= format('%02d', modulo.position) %></span>

        <div class="module-card__content">
          <p class="module-card__status"><%= completed ? t("home.module.completed") : available ? t("modules.available") : t("modules.locked") %></p>
          <h3 class="type-display text-xl leading-tight sm:text-2xl"><%= I18n.locale == :en ? modulo.title_en : modulo.title_pt %></h3>
          <p class="mt-2 text-sm leading-6 text-tx1"><%= available ? t('home.module.questions', count: modulo.questions.count(&:published?)) : t('modules.complete_previous') %></p>
        </div>

        <% if available %>
          <%= link_to play_quiz_module_path(modulo.slug, locale: I18n.locale), class: "focus-ink module-card__action" do %>
            <%= completed ? t("home.module.review") : t('modules.play') %><span aria-hidden="true">→</span>
          <% end %>
        <% else %>
          <span class="module-card__locked"><%= t('modules.locked') %></span>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
