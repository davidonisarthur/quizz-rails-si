<div class="max-w-md mx-auto py-10 px-4">
  <h2 class="text-3xl font-bold mb-6 text-center"><%= t('users.new.title') %></h2>

  <%= form_with model: @user, url: users_path(locale: I18n.locale), class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-red/10 text-red border border-red/30 p-4 rounded-xl mb-4 text-sm font-medium">
        <ul class="list-disc pl-5 space-y-1">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, t('users.new.name'), class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :name, required: true, class: "w-full p-2.5 rounded-lg border border-bg3 bg-bg2 text-tx0 focus:ring-2 focus:ring-accent focus:outline-none" %>
    </div>

    <div>
      <%= f.label :email, t('users.new.email'), class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, required: true, class: "w-full p-2.5 rounded-lg border border-bg3 bg-bg2 text-tx0 focus:ring-2 focus:ring-accent focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, t('users.new.password'), class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, required: true, class: "w-full p-2.5 rounded-lg border border-bg3 bg-bg2 text-tx0 focus:ring-2 focus:ring-accent focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password_confirmation, t('users.new.password_confirmation'), class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password_confirmation, required: true, class: "w-full p-2.5 rounded-lg border border-bg3 bg-bg2 text-tx0 focus:ring-2 focus:ring-accent focus:outline-none" %>
    </div>

    <%= f.submit t('users.new.submit'), class: "w-full bg-accent text-white py-2.5 rounded-lg font-bold hover:brightness-110 shadow transition cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-center text-sm text-tx1">
    <%= t('users.new.already_have_account') %> <%= link_to t('users.new.sign_in'), new_session_path(locale: I18n.locale), class: "text-accent hover:underline font-semibold" %>
  </p>
</div>
