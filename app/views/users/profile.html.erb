<div class="max-w-2xl mx-auto py-10 px-4">
  <h2 class="text-3xl font-bold mb-2 text-tx0"><%= current_user.name %></h2>
  <p class="text-tx2 mb-8"><%= current_user.email %></p>

  <h3 class="text-xl font-bold mb-4 text-tx1"><%= t('profile.my_attempts') %></h3>

  <div class="space-y-4">
    <% @attempts.each do |attempt| %>
      <div class="p-4 bg-bg2 rounded-xl border border-bg3 shadow-sm flex justify-between items-center transition">
        <div>
          <h4 class="font-bold text-tx0"><%= I18n.locale == :en ? attempt.quiz_module.title_en : attempt.quiz_module.title_pt %></h4>
          <p class="text-xs text-tx2"><%= l attempt.created_at, format: :short %></p>
        </div>
        <div class="text-lg font-bold text-accent">
          <%= attempt.score %>
        </div>
      </div>
    <% end %>

    <% if @attempts.empty? %>
      <p class="text-center py-10 text-tx2 font-medium"><%= t('profile.no_attempts') %></p>
    <% end %>
  </div>
</div>
