<section class="mx-auto max-w-4xl py-10 sm:py-16">
  <header class="border-b ink-rule pb-8">
    <p class="eyebrow"><%= current_user.email %></p>
    <h1 class="type-display mt-3 text-4xl sm:text-5xl"><%= current_user.name %></h1>
    <div class="mt-8 max-w-xl">
      <div class="flex items-center justify-between gap-4">
        <p class="text-sm font-bold"><%= t('profile.progress') %></p>
        <p class="text-sm text-tx2"><%= t('profile.completion', completed: @completed_modules.count, total: @modules.count) %></p>
      </div>
      <div class="mt-3 h-2 bg-bg3" aria-hidden="true"><div class="h-full bg-accent transition-all duration-500" style="width: <%= @completion_percentage %>%"></div></div>
    </div>
    <% if current_user.student? %>
      <div class="mt-6"><% if @teacher_access_request %><p class="text-sm text-tx2"><%= t("teacher_requests.already_pending") %></p><% else %><%= button_to t("teacher_requests.title"), teacher_access_requests_path(locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" %><% end %></div>
    <% end %>
  </header>

  <section class="mt-10">
    <h2 class="type-display text-3xl"><%= t('profile.to_continue') %></h2>
    <% if @next_module %>
      <% quiz_module = @next_module[:quiz_module] %>
      <article class="mt-5 flex flex-wrap items-center justify-between gap-5 border-y ink-rule py-6">
        <div class="max-w-2xl">
          <p class="eyebrow"><%= t('profile.available') %></p>
          <h3 class="mt-2 text-xl font-bold"><%= I18n.locale == :en ? quiz_module.title_en : quiz_module.title_pt %></h3>
          <p class="mt-2 text-sm text-tx2"><%= quiz_module.questions.published.count %> <%= t('teacher.questions') %></p>
        </div>
        <%= link_to t('profile.start_module'), play_quiz_module_path(quiz_module.slug, locale: I18n.locale), class: "focus-ink inline-flex min-h-11 w-full items-center justify-center rounded-md bg-accent px-4 py-3 text-xs font-extrabold tracking-[0.1em] text-bg2 uppercase transition-colors hover:bg-tx0 sm:w-auto" %>
      </article>
    <% else %>
      <p class="mt-5 border-y ink-rule py-6 text-tx1"><%= @pending_modules.any? ? t('profile.no_available_module') : t('profile.no_pending_modules') %></p>
    <% end %>

    <% if @other_pending_modules.any? %>
      <details class="group border-b ink-rule">
        <summary class="focus-ink flex cursor-pointer list-none items-center justify-between py-5 text-sm font-bold text-tx1 hover:text-accent [&::-webkit-details-marker]:hidden"><%= t('profile.show_pending_modules', count: @other_pending_modules.count) %><span class="group-open:text-accent" aria-hidden="true">+</span></summary>
        <div class="pb-5">
          <% @other_pending_modules.each do |progress| %>
            <% quiz_module = progress[:quiz_module] %>
            <div class="flex items-center justify-between gap-4 py-3 text-sm"><span><%= I18n.locale == :en ? quiz_module.title_en : quiz_module.title_pt %></span><span class="text-tx2"><%= progress[:available] ? t('profile.available') : t('profile.locked') %></span></div>
          <% end %>
        </div>
      </details>
    <% end %>
  </section>

  <section class="mt-12">
    <h2 class="type-display text-3xl"><%= t('profile.completed_modules') %></h2>
    <% if @completed_modules.any? %>
      <div class="mt-5">
        <% @completed_modules.each do |progress| %>
          <% quiz_module = progress[:quiz_module] %>
          <% best_attempt = progress[:best_attempt] %>
          <article class="grid gap-4 border-b ink-rule py-5 sm:grid-cols-[1fr_auto_auto] sm:items-center">
            <div>
              <h3 class="font-bold"><%= I18n.locale == :en ? quiz_module.title_en : quiz_module.title_pt %></h3>
              <p class="mt-1 text-sm text-tx2"><%= t('profile.last_attempt') %>: <%= l(progress[:last_attempt].created_at, format: :short) %></p>
            </div>
            <div class="sm:text-right">
              <p class="eyebrow"><%= t('profile.best_score') %></p>
              <p class="mt-1 text-lg font-bold text-accent"><%= t('profile.score_of', score: best_attempt.score, total: progress[:question_count]) %> <span class="text-sm text-tx2">· <%= progress[:best_percentage] %>%</span></p>
            </div>
            <%= link_to t('profile.retry_module'), play_quiz_module_path(quiz_module.slug, locale: I18n.locale), class: "focus-ink editorial-link min-h-11 py-3 text-sm font-bold sm:justify-self-end" %>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="mt-5 border-b ink-rule py-6 text-tx1"><%= t('profile.no_completed_modules') %></p>
    <% end %>
  </section>

  <% if @attempts.any? %>
    <section class="mt-12">
      <details class="group border-y ink-rule">
        <summary class="focus-ink flex cursor-pointer list-none items-center justify-between py-5 text-sm font-bold text-tx1 hover:text-accent [&::-webkit-details-marker]:hidden"><%= t('profile.attempts_history', count: @attempts.count) %><span class="group-open:text-accent" aria-hidden="true">+</span></summary>
        <div class="pb-5">
          <% @attempts.each do |attempt| %>
            <article class="grid grid-cols-[1fr_auto] gap-4 border-t ink-rule py-4">
              <div><h3 class="font-bold"><%= I18n.locale == :en ? attempt.quiz_module.title_en : attempt.quiz_module.title_pt %></h3><p class="mt-1 text-xs text-tx2"><%= l attempt.created_at, format: :short %></p></div>
              <p class="text-lg font-bold text-accent"><%= attempt.score %></p>
            </article>
          <% end %>
        </div>
      </details>
    </section>
  <% end %>
</section>
