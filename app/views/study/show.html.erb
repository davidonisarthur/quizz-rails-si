<% libras_study = libras_mode_enabled? %>

<section class="mx-auto max-w-5xl py-10 sm:py-16">
  <%= link_to study_path(locale: I18n.locale), class: "focus-ink editorial-link text-sm font-bold" do %>
    <span aria-hidden="true">←</span> <%= t("study.back_to_catalog") %>
  <% end %>

  <div class="mt-8 max-w-3xl">
    <p class="eyebrow"><%= t("study.eyebrow") %></p>
    <h1 class="type-display mt-4 text-4xl leading-tight sm:text-6xl"><%= t("study.title") %></h1>
    <p class="mt-6 text-base leading-8 text-tx1 sm:text-lg"><%= t(libras_study ? "study.libras.introduction" : "study.description") %></p>
  </div>

  <% if libras_study %>
    <aside class="mt-8 border-l-4 border-accent bg-bg1 p-5 text-sm leading-7 text-tx1" aria-label="<%= t("study.libras.label") %>">
      <p class="eyebrow text-accent"><%= t("study.libras.label") %></p>
      <p class="mt-2"><%= t("study.libras.notice") %></p>
    </aside>

    <section class="mt-10 grid gap-6 md:grid-cols-2" aria-labelledby="history-title">
      <figure class="overflow-hidden rounded-xl border ink-rule bg-bg2">
        <%= image_tag "study/alan-turing-1951.jpg", alt: t("study.images.alan_alt"), class: "h-80 w-full object-cover object-top", loading: "lazy" %>
        <figcaption class="p-4 text-xs leading-6 text-tx2"><%= t("study.libras.history_caption") %></figcaption>
      </figure>
      <article class="rounded-xl border ink-rule bg-bg2 p-6 sm:p-8">
        <p class="eyebrow text-accent"><%= t("study.libras.history_label") %></p>
        <h2 id="history-title" class="type-display mt-3 text-3xl"><%= t("study.libras.history_title") %></h2>
        <ul class="mt-6 space-y-4 text-base leading-7 text-tx1">
          <% 1.upto(3) do |item| %>
            <li class="flex gap-3"><span class="module-index text-accent"><%= format("%02d", item) %></span><span><%= t("study.libras.history_#{item}") %></span></li>
          <% end %>
        </ul>
      </article>
    </section>

    <section class="mt-12 grid gap-6 border-t ink-rule pt-8 md:grid-cols-[0.8fr_1.2fr]" aria-labelledby="model-title">
      <figure class="rounded-xl border border-bg3 bg-white p-4">
        <%= image_tag "study/turing-machine-diagram.png", alt: t("study.images.diagram_alt"), class: "mx-auto w-full max-w-sm", loading: "lazy" %>
      </figure>
      <article>
        <p class="eyebrow text-accent"><%= t("study.libras.model_label") %></p>
        <h2 id="model-title" class="type-display mt-3 text-3xl"><%= t("study.libras.model_title") %></h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <% %w[tape head rules].each_with_index do |part, index| %>
            <div class="border-l-2 border-accent bg-bg1 p-4">
              <p class="eyebrow"><%= format("%02d", index + 1) %></p>
              <p class="mt-2 text-sm leading-6 text-tx1"><%= t("study.libras.model.#{part}") %></p>
            </div>
          <% end %>
        </div>
      </article>
    </section>

    <%= render "turing_machine_simulator", libras_study: true %>

    <section class="mt-12 grid gap-6 border-t ink-rule pt-8 md:grid-cols-[1.2fr_0.8fr]" aria-labelledby="importance-title">
      <article>
        <p class="eyebrow text-accent"><%= t("study.libras.importance_label") %></p>
        <h2 id="importance-title" class="type-display mt-3 text-3xl"><%= t("study.libras.importance_title") %></h2>
        <p class="mt-5 text-base leading-8 text-tx1"><%= t("study.libras.importance_text") %></p>
      </article>
      <figure class="overflow-hidden rounded-xl border ink-rule bg-bg2">
        <%= image_tag "study/bletchley-park.jpg", alt: t("study.images.bletchley_alt"), class: "h-56 w-full object-cover", loading: "lazy" %>
        <figcaption class="p-4 text-xs leading-6 text-tx2"><%= t("study.libras.bletchley_caption") %></figcaption>
      </figure>
    </section>
  <% else %>
    <section class="mt-10 grid gap-6 lg:grid-cols-[1.25fr_0.75fr]" aria-labelledby="history-title">
      <article class="rounded-xl border ink-rule bg-bg2 p-6 sm:p-8">
        <p class="eyebrow text-accent"><%= t("study.history_label") %></p>
        <h2 id="history-title" class="type-display mt-3 text-3xl"><%= t("study.featured_title") %></h2>
        <div class="mt-5 text-sm leading-7 text-tx1 sm:text-base"><p><%= t("study.featured_paragraph_one") %></p></div>
        <figure class="mt-6 overflow-hidden rounded-lg border border-bg3 bg-bg1"><%= image_tag "study/alan-turing-1951.jpg", alt: t("study.images.alan_alt"), class: "h-72 w-full object-cover object-top", loading: "lazy" %></figure>
      </article>
      <aside class="border-l-4 border-accent bg-bg1 p-6 sm:p-8" aria-labelledby="study-timeline-title">
        <p class="eyebrow"><%= t("study.timeline_label") %></p>
        <h2 id="study-timeline-title" class="type-display mt-3 text-2xl"><%= t("study.timeline_title") %></h2>
        <ol class="mt-6 space-y-5 text-sm text-tx1"><% 1.upto(3) do |step| %><li class="flex gap-3"><span class="module-index text-accent"><%= format("%02d", step) %></span><span><%= t("study.timeline_step_#{step}") %></span></li><% end %></ol>
      </aside>
    </section>

    <section class="mt-12 grid gap-6 border-t ink-rule pt-8 md:grid-cols-[1.2fr_0.8fr]" aria-labelledby="model-title">
      <div>
        <p class="eyebrow text-accent"><%= t("study.model_label") %></p>
        <h2 id="model-title" class="type-display mt-3 text-3xl sm:text-4xl"><%= t("study.model_title") %></h2>
        <p class="mt-5 text-base leading-8 text-tx1"><%= t("study.model_description") %></p>
      </div>
      <figure class="rounded-xl border border-bg3 bg-white p-4"><%= image_tag "study/turing-machine-diagram.png", alt: t("study.images.diagram_alt"), class: "mx-auto w-full max-w-sm", loading: "lazy" %></figure>
    </section>

    <%= render "turing_machine_simulator", libras_study: false %>

    <section class="mt-12 border-t ink-rule pt-8" aria-labelledby="importance-title">
      <div class="grid gap-6 md:grid-cols-[0.8fr_1.2fr]">
        <figure class="overflow-hidden rounded-xl border ink-rule bg-bg2">
          <%= image_tag "study/bletchley-park.jpg", alt: t("study.images.bletchley_alt"), class: "h-64 w-full object-cover", loading: "lazy" %>
          <figcaption class="p-4 text-xs leading-6 text-tx2"><%= t("study.images.bletchley_caption") %></figcaption>
        </figure>
        <div>
          <p class="eyebrow"><%= t("study.importance_label") %></p>
          <h2 id="importance-title" class="type-display mt-3 text-3xl sm:text-4xl"><%= t("study.importance_title") %></h2>
        </div>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-3"><% %w[limits languages legacy].each_with_index do |topic, index| %><article class="rounded-xl border ink-rule bg-bg2 p-6"><p class="eyebrow text-accent"><%= format("%02d", index + 1) %></p><h3 class="type-display mt-4 text-2xl"><%= t("study.importance.#{topic}.title") %></h3><p class="mt-3 text-sm leading-7 text-tx1"><%= t("study.importance.#{topic}.description") %></p></article><% end %></div>
    </section>
  <% end %>

  <%= render "image_credits" %>
</section>
