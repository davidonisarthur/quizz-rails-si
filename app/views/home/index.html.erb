<% learner_name = current_user&.name&.split&.first %>

<section class="learning-dashboard py-4 sm:py-8">
  <header class="learning-dashboard__header">
    <div>
      <p class="eyebrow"><%= t("home.eyebrow") %></p>
      <h1 class="type-display mt-2 text-3xl leading-tight sm:text-4xl"><%= learner_name.present? ? t("home.greeting", name: learner_name) : t("home.greeting_guest") %></h1>
    </div>

    <% if current_user %>
      <%= link_to profile_path(locale: I18n.locale), class: "focus-ink dashboard-profile-link" do %>
        <span class="dashboard-profile-link__initial" aria-hidden="true"><%= learner_name&.first&.upcase || "P" %></span>
        <span><%= t("navigation.profile") %></span>
      <% end %>
    <% end %>
  </header>

  <div class="learning-dashboard__lead-grid">
    <section class="prime-hero" aria-labelledby="home-hero-title">
      <div class="prime-hero__copy">
        <p class="prime-hero__eyebrow"><%= t("home.hero_eyebrow") %></p>
        <h2 id="home-hero-title" class="prime-hero__title"><%= t("home.hero_title") %></h2>
        <p class="prime-hero__description"><%= t("home.hero_description") %></p>
        <% if @next_module %>
          <%= link_to play_quiz_module_path(@next_module.slug, locale: I18n.locale), class: "focus-ink lime-button" do %>
            <%= t("home.hero_cta") %><span aria-hidden="true">→</span>
          <% end %>
        <% else %>
          <%= link_to study_path(locale: I18n.locale), class: "focus-ink lime-button" do %>
            <%= t("study.home_cta") %><span aria-hidden="true">→</span>
          <% end %>
        <% end %>
      </div>

      <div class="prime-orbit" aria-hidden="true">
        <span class="prime-orbit__ring prime-orbit__ring--one"></span>
        <span class="prime-orbit__ring prime-orbit__ring--two"></span>
        <span class="prime-orbit__core">P</span>
        <% [ 2, 3, 5, 7, 11, 13 ].each_with_index do |number, index| %>
          <span class="prime-orbit__number prime-orbit__number--<%= index + 1 %>"><%= number %></span>
        <% end %>
      </div>
    </section>

    <aside class="progress-summary" aria-labelledby="progress-summary-title">
      <div class="progress-summary__icon" aria-hidden="true">↗</div>
      <p class="eyebrow"><%= t("home.progress.eyebrow") %></p>
      <h2 id="progress-summary-title" class="type-display mt-2 text-3xl"><%= @completion_percentage %>%</h2>
      <p class="mt-1 text-sm leading-6 text-tx1"><%= t("home.progress.modules", completed: @completed_modules_count, total: @modules.count) %></p>
      <div class="progress-summary__track" role="progressbar" aria-label="<%= t("home.progress.eyebrow") %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= @completion_percentage %>">
        <span style="width: <%= @completion_percentage %>%"></span>
      </div>
      <p class="progress-summary__sessions"><strong><%= @attempts_count %></strong> <%= t("home.progress.sessions", count: @attempts_count) %></p>
      <% if current_user %>
        <%= link_to t("home.progress.cta"), profile_path(locale: I18n.locale), class: "focus-ink dashboard-text-link" %>
      <% else %>
        <%= link_to t("sessions.sign_up"), new_user_path(locale: I18n.locale), class: "focus-ink dashboard-text-link" %>
      <% end %>
    </aside>
  </div>

  <div class="learning-dashboard__content-grid">
    <%= render "quiz_modules/catalog", heading: t("home.continue_title"), dashboard: true %>

    <aside class="learning-side-stack" aria-label="<%= t("home.support_label") %>">
      <section class="learning-side-card learning-side-card--study">
        <span class="learning-side-card__icon" aria-hidden="true">✦</span>
        <p class="eyebrow"><%= t("study.eyebrow") %></p>
        <h2 class="type-display mt-2 text-2xl"><%= t("home.study_card.title") %></h2>
        <p class="mt-3 text-sm leading-6 text-tx1"><%= t("home.study_card.description") %></p>
        <%= link_to t("home.study_card.cta"), study_path(locale: I18n.locale), class: "focus-ink dashboard-text-link mt-5 inline-flex" %>
      </section>

      <section class="learning-side-card learning-side-card--libras">
        <span class="learning-side-card__icon learning-side-card__icon--coral" aria-hidden="true">⌁</span>
        <p class="eyebrow"><%= t("home.libras_card.eyebrow") %></p>
        <h2 class="type-display mt-2 text-2xl"><%= t("home.libras_card.title") %></h2>
        <p class="mt-3 text-sm leading-6 text-tx1"><%= t("home.libras_card.description") %></p>
        <%= button_to toggle_libras_mode_path(locale: I18n.locale), method: :post, class: "focus-ink dashboard-text-link mt-5 inline-flex cursor-pointer" do %><%= t("home.libras_card.cta") %><% end %>
      </section>
    </aside>
  </div>
</section>
