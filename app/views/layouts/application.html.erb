<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= javascript_tag nonce: true do %>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    <% end %>
    <title><%= content_for(:title) || "PrimoQuiz" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PrimoQuiz">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script defer src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
  </head>

  <body class="min-h-screen bg-bg0 text-tx0 antialiased">
    <div class="mx-auto min-h-screen max-w-[1440px] bg-bg0">
      <nav aria-label="<%= t('navigation.main') %>" class="border-b ink-rule bg-bg2 px-5 py-4 sm:px-8">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-8 gap-y-4">
          <%= link_to root_path(locale: I18n.locale), class: "focus-ink leading-none" do %>
            <span class="type-display text-3xl">Primo<span class="text-accent">Quiz</span></span>
            <span class="mt-1 block text-[0.6rem] font-bold tracking-[0.22em] text-tx1 uppercase"><%= t('brand.subtitle') %></span>
          <% end %>

          <div class="flex flex-wrap items-center gap-x-5 gap-y-3 text-xs font-bold tracking-[0.09em] uppercase">
            <%= link_to t('ranking.title'), ranking_path(locale: I18n.locale), class: "editorial-link focus-ink text-tx0" %>
            <%= link_to t('about'), about_path(locale: I18n.locale), class: "editorial-link focus-ink text-tx0" %>

            <% if current_user %>
              <%= link_to current_user.name, profile_path(locale: I18n.locale), class: "editorial-link focus-ink text-tx0 normal-case tracking-normal" %>
              <%= button_to t('sessions.sign_out'), session_path(locale: I18n.locale), method: :delete, class: "editorial-link focus-ink cursor-pointer text-tx0" %>
            <% else %>
              <%= link_to t('sessions.sign_in'), new_session_path(locale: I18n.locale), class: "editorial-link focus-ink text-tx0" %>
            <% end %>

            <%= button_to toggle_libras_mode_path(locale: I18n.locale),
                          method: :post,
                          class: "focus-ink border-b-2 px-0.5 pb-1 text-[0.65rem] font-extrabold tracking-[0.12em] uppercase cursor-pointer #{libras_mode_enabled? ? 'border-accent text-accent' : 'border-transparent text-tx1 hover:border-tx1 hover:text-tx0'}",
                          aria: { label: t('quiz.libras_mode') } do %>
              <%= t('quiz.libras_mode') %>
            <% end %>

            <button type="button"
                    data-controller="theme"
                    data-action="click->theme#toggle"
                    class="focus-ink border-b-2 border-transparent px-0.5 pb-1 text-[0.65rem] font-extrabold tracking-[0.12em] text-tx1 uppercase hover:border-tx1 hover:text-tx0 cursor-pointer"
                    aria-label="<%= t('theme.toggle') %>">
              <%= t('theme.label') %>
            </button>

            <div class="flex gap-2 border-l ink-rule pl-4">
              <%= link_to "PT", { locale: 'pt-BR' }, class: "focus-ink #{I18n.locale == :'pt-BR' ? 'text-accent' : 'text-tx2'}", aria: { current: I18n.locale == :'pt-BR' ? 'page' : nil } %>
              <%= link_to "EN", { locale: 'en' }, class: "focus-ink #{I18n.locale == :en ? 'text-accent' : 'text-tx2'}", aria: { current: I18n.locale == :en ? 'page' : nil } %>
            </div>
          </div>
        </div>
      </nav>

      <main class="mx-auto max-w-7xl px-5 py-8 sm:px-8 sm:py-12">
      <% if flash[:alert] %>
        <div class="mb-8 border-l-4 border-red bg-red/10 px-5 py-4 text-sm font-bold text-red">
          <%= flash[:alert] %>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div class="mb-8 border-l-4 border-green bg-green/10 px-5 py-4 text-sm font-bold text-green">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <%= yield %>
      </main>

      <footer class="mx-5 border-t ink-rule py-5 text-[0.65rem] font-bold tracking-[0.1em] text-tx2 uppercase sm:mx-8">
        PrimoQuiz · <%= t('brand.footer') %>
      </footer>
    </div>

    <!-- VLibras Widget Container (Permanent across Turbo navigations) -->
    <div id="vlibras-widget-container" data-turbo-permanent data-controller="vlibras"></div>
  </body>
</html>
