#!/usr/bin/env ruby
require "rubygems"
require "bundler/setup"

# Keep local analysis deterministic and offline-friendly. CI can opt into the
# release freshness check with BRAKEMAN_ENSURE_LATEST=true.
ARGV.unshift("--ensure-latest") if ENV["BRAKEMAN_ENSURE_LATEST"] == "true"

load Gem.bin_path("brakeman", "brakeman")
